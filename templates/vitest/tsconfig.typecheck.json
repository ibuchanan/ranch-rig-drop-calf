{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",

    // Vitest's export maps need modern resolution for local checks only.
    // The Forge bundler still reads the unchanged tsconfig.json.
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src", "test", "tests", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "coverage", "specs"]
}
