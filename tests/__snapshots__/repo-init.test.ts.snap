// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`profiles agent-skill contains no test scripts and all kinds keep a complete blueprint: library 1`] = `
{
  "files": [
    ".atlassian/OWNER",
    ".npmrc",
    ".nvmrc",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "biome.jsonc",
    "cliff.toml",
    "tsconfig.json",
    "tsconfig.typecheck.json",
    "tsdown.config.ts",
  ],
  "packageJson": {
    "author": "tester",
    "description": "",
    "devDependencies": {
      "@biomejs/biome": "2.5.15",
      "@size-limit/file": "^5.0.0",
      "@types/node": "24",
      "cspell": "^10.3",
      "git-cliff": "^2.13",
      "lefthook": "^2.1",
      "markdownlint-cli2": "^0.23",
      "size-limit": "^11.2.0",
      "tsdown": "^0.15.0",
      "typescript": "^5.9.3",
    },
    "engines": {
      "node": "24.x",
    },
    "exports": {
      ".": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts",
      },
    },
    "license": "Apache-2.0",
    "main": "./dist/index.js",
    "name": "sample",
    "private": true,
    "scripts": {
      "build": "tsdown",
      "changelog": "git cliff --config cliff.toml --unreleased -o CHANGELOG.md",
      "check": "lefthook run pre-push --force",
      "clean": "rm -rf dist",
      "format": "biome format --write",
      "format:check": "biome format",
      "lint": "lefthook run lint",
      "lint:check": "biome lint",
      "lint:docs": "markdownlint-cli2 "**/*.md" && cspell lint "**/*.md"",
      "lint:fix": "biome lint --write",
      "prepare": "lefthook install || true",
      "size": "npm run build && size-limit",
      "test": "bun test --pass-with-no-tests",
      "test:coverage": "bun test --coverage --pass-with-no-tests",
      "test:watch": "bun test --watch --pass-with-no-tests",
      "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    },
    "size-limit": [
      {
        "limit": "10 kB",
        "name": "Library bundle",
        "path": "dist/index.js",
      },
    ],
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "0.1.0",
  },
}
`;

exports[`profiles agent-skill contains no test scripts and all kinds keep a complete blueprint: forge-app 1`] = `
{
  "files": [
    ".atlassian/OWNER",
    ".npmrc",
    ".nvmrc",
    "AGENTS.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "biome.jsonc",
    "cliff.toml",
    "tsconfig.json",
    "tsconfig.typecheck.json",
    "vitest.config.ts",
  ],
  "packageJson": {
    "author": "tester",
    "dependencies": {
      "@forge-ahead/atlassian-api-types": "github:ibuchanan/forge-ahead-atlassian-api-types",
      "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
      "@forge-ahead/logging": "github:ibuchanan/forge-ahead-logging",
    },
    "description": "",
    "devDependencies": {
      "@ast-grep/cli": "^0.45",
      "@biomejs/biome": "2.5.15",
      "@forge-ahead/prelint": "github:ibuchanan/tool-forge-prelint-ast-grep",
      "@size-limit/file": "^5.0.0",
      "@types/node": "24",
      "@vitest/coverage-v8": "5.0.3",
      "cspell": "^10.3",
      "git-cliff": "^2.13",
      "lefthook": "^2.1",
      "markdownlint-cli2": "^0.23",
      "size-limit": "^11.2.0",
      "typescript": "^5.9.3",
      "vitest": "5.0.3",
    },
    "engines": {
      "node": "24.x",
    },
    "license": "Apache-2.0",
    "name": "sample",
    "private": true,
    "scripts": {
      "build": "tsc --project tsconfig.json",
      "changelog": "git cliff --config cliff.toml --unreleased -o CHANGELOG.md",
      "check": "lefthook run pre-push --force",
      "clean": "rm -rf dist",
      "forge:deploy": "bash scripts/env-var.sh 'forge deploy --non-interactive --environment "$FORGE_ENVIRONMENT"'",
      "forge:install": "bash scripts/env-var.sh 'forge install --non-interactive --confirm-scopes --site "$FORGE_SITE" --product "$FORGE_PRODUCT" --environment "$FORGE_ENVIRONMENT"'",
      "forge:register": "bash scripts/env-var.sh 'forge register'",
      "forge:uninstall": "bash scripts/env-var.sh 'forge uninstall --site "$FORGE_SITE" --product "$FORGE_PRODUCT" --environment "$FORGE_ENVIRONMENT"'",
      "forge:upgrade": "bash scripts/env-var.sh 'forge install --upgrade --non-interactive --confirm-scopes --site "$FORGE_SITE" --product "$FORGE_PRODUCT" --environment "$FORGE_ENVIRONMENT"'",
      "forge:variables:set": "node scripts/forge-vars-from-secretspec.js",
      "format": "biome format --write",
      "format:check": "biome format",
      "lint": "lefthook run lint",
      "lint:check": "biome lint",
      "lint:docs": "markdownlint-cli2 "**/*.md" && cspell lint "**/*.md"",
      "lint:fix": "biome lint --write",
      "lint:forge": "forge lint",
      "lint:prelint": "ast-grep scan --globs '!specs/**' --globs '!node_modules/**' --config ./node_modules/@forge-ahead/prelint/sgconfig.ecosol.yml",
      "prepare": "lefthook install || true",
      "size": "npm run build && size-limit",
      "test": "vitest run --passWithNoTests",
      "test:coverage": "vitest run --coverage --passWithNoTests",
      "test:watch": "vitest watch --passWithNoTests",
      "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    },
    "size-limit": [
      {
        "limit": "10 kB",
        "name": "Forge app bundle",
        "path": "dist/**/*.js",
      },
    ],
    "type": "module",
    "version": "0.1.0",
  },
}
`;

