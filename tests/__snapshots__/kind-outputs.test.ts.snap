"{
  "packageJson": {
    "name": "sample",
    "version": "0.1.0",
    "type": "module",
    "license": "Apache-2.0",
    "scripts": {
      "changelog": "git cliff --config cliff.toml --unreleased",
      "lint": "lefthook run esa-lint",
      "lint:fix": "biome lint --write",
      "format": "biome format --write",
      "format:check": "biome format",
      "lint:check": "biome lint",
      "build": "tsdown",
      "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
      "test": "bun test --pass-with-no-tests",
      "test:watch": "bun test --watch --pass-with-no-tests",
      "test:coverage": "bun test --coverage --pass-with-no-tests",
      "size": "npm run build && size-limit",
      "clean": "rm -rf dist",
      "lint:docs": "markdownlint-cli2 \\"**/*.md\\" && cspell lint \\"**/*.md\\"",
      "prepare": "lefthook install",
      "check": "lefthook run pre-push --force"
    },
    "devDependencies": {
      "@types/node": "24",
      "git-cliff": "^2.13",
      "@biomejs/biome": "^1.9.4",
      "typescript": "^5.9.3",
      "tsdown": "^0.15.0",
      "size-limit": "^11.2.0",
      "@size-limit/file": "^5.0.0",
      "cspell": "^10.3",
      "markdownlint-cli2": "^0.23",
      "lefthook": "^1.11.0"
    },
    "description": "A sample project",
    "engines": {
      "node": "24.x"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "size-limit": [
      {
        "name": "Library bundle",
        "path": "dist/index.js",
        "limit": "10 kB"
      }
    ]
  },
  "files": {
    ".editorconfig": "root = true\\n\\n[*]\\ncharset = utf-8\\nend_of_line = lf\\ninsert_final_newline = true\\ntrim_trailing_whitespace = true\\nindent_style = space\\nindent_size = 2\\n\\n[*.md]\\ntrim_trailing_whitespace = false\\n",
    ".nvmrc": "24\\n",
    ".npmrc": "# Use the public npm registry (not the default for internal Atlassians)\\nregistry=https://registry.npmjs.org/\\n",
    "biome.json": "{\\n  \\"$schema\\": \\"https://biomejs.dev/schemas/1.9.4/schema.json\\",\\n  \\"organizeImports\\": {\\n    \\"enabled\\": true\\n  },\\n  \\"linter\\": {\\n    \\"enabled\\": true,\\n    \\"rules\\": {\\n      \\"recommended\\": true\\n    }\\n  },\\n  \\"formatter\\": {\\n    \\"enabled\\": true,\\n    \\"indentStyle\\": \\"space\\",\\n    \\"indentWidth\\": 2,\\n    \\"lineEnding\\": \\"lf\\"\\n  },\\n  \\"files\\": {\\n    \\"ignore\\": [\\n      \\"node_modules\\",\\n      \\"dist\\"\\n    ]\\n  }\\n}\\n",
    "tsdown.config.ts": "import { defineConfig } from \\"tsdown\\";\\n\\nexport default defineConfig({ entry: [\\"src/index.ts\\"], outDir: \\"dist\\", format: [\\"esm\\"], dts: true });\\n",
    "lefthook.yml": "colors: false\\noutput:\\n  - meta\\n  - summary\\n  - failure\\n\\nesa-lint:\\n  commands:\\n    esa-lint:\\n      run: npm run lint:check && npm run typecheck\\n\\npre-commit:\\n  parallel: true\\n  commands:\\n    esa-gitleaks:\\n      run: |\\n        command -v gitleaks >/dev/null 2>&1 || {\\n          echo \\"gitleaks not found on PATH. Install it with: brew install gitleaks\\" >&2\\n          exit 1\\n        }\\n        gitleaks git --pre-commit --staged\\n    esa-format:\\n      run: npm run format\\n      stage_fixed: true\\n\\npre-push:\\n  commands:\\n    esa-format-check:\\n      run: npm run format:check\\n    esa-lint:\\n      run: npm run lint\\n    esa-test:\\n      run: npm run test\\n"
  }
}"
`;

