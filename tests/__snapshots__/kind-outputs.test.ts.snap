"{
  "packageJson": {
    "name": "sample",
    "version": "0.1.0",
    "type": "module",
    "license": "Apache-2.0",
    "scripts": {
      "changelog": "git cliff --config cliff.toml --unreleased -o CHANGELOG.md",
      "forge:register": "bash scripts/env-var.sh 'forge register'",
      "forge:deploy": "bash scripts/env-var.sh 'forge deploy --environment \\"$FORGE_ENVIRONMENT\\"'",
      "forge:install": "bash scripts/env-var.sh 'forge install --site \\"$FORGE_SITE\\" --product \\"$FORGE_PRODUCT\\" --environment \\"$FORGE_ENVIRONMENT\\"'",
      "forge:uninstall": "bash scripts/env-var.sh 'forge uninstall --site \\"$FORGE_SITE\\" --product \\"$FORGE_PRODUCT\\" --environment \\"$FORGE_ENVIRONMENT\\"'",
      "forge:upgrade": "bash scripts/env-var.sh 'forge install --upgrade --site \\"$FORGE_SITE\\" --product \\"$FORGE_PRODUCT\\" --environment \\"$FORGE_ENVIRONMENT\\"'",
      "forge:variables:set": "node scripts/forge-vars-from-secretspec.js",
      "lint:prelint": "ast-grep scan --globs '!specs/**' --globs '!node_modules/**' --config ./node_modules/@forge-ahead/prelint/sgconfig.ecosol.yml",
      "lint:forge": "forge lint",
      "lint": "lefthook run lint",
      "format": "biome format --write",
      "format:check": "biome format",
      "lint:check": "biome lint",
      "lint:fix": "biome lint --write",
      "build": "tsc --project tsconfig.json",
      "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
      "test": "bun test --pass-with-no-tests",
      "test:watch": "bun test --watch --pass-with-no-tests",
      "test:coverage": "bun test --coverage --pass-with-no-tests",
      "size": "npm run build && size-limit",
      "clean": "rm -rf dist",
      "lint:docs": "markdownlint-cli2 \\"**/*.md\\" && cspell lint \\"**/*.md\\"",
      "prepare": "lefthook install || true",
      "check": "lefthook run pre-push --force"
    },
    "devDependencies": {
      "@types/node": "24",
      "git-cliff": "^2.13",
      "@ast-grep/cli": "^0.45",
      "@forge-ahead/prelint": "github:ibuchanan/tool-forge-prelint-ast-grep",
      "@biomejs/biome": "2.5.15",
      "typescript": "^5.9.3",
      "size-limit": "^11.2.0",
      "@size-limit/file": "^5.0.0",
      "cspell": "^10.3",
      "markdownlint-cli2": "^0.23",
      "lefthook": "^2.1"
    },
    "description": "A sample project",
    "engines": {
      "node": "24.x"
    },
    "dependencies": {
      "@forge-ahead/atlassian-api-types": "github:ibuchanan/forge-ahead-atlassian-api-types",
      "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
      "@forge-ahead/logging": "github:ibuchanan/forge-ahead-logging"
    },
    "size-limit": [
      {
        "name": "Forge app bundle",
        "path": "dist/**/*.js",
        "limit": "10 kB"
      }
    ]
  },
  "files": {
    ".nvmrc": "24\\n",
    ".npmrc": "# Use the public npm registry (not the default for internal Atlassians)\\nregistry=https://registry.npmjs.org/\\n",
    "AGENTS.md": "# Agent guidance\\n\\nThis repository is an Atlassian Forge app. Read \`manifest.yml\` before\\nchanging modules, functions, scopes, or external permissions. Prefer\\nForge's built-in authentication and storage to custom services; check\\nauthorization when using app-level access.\\n\\nBefore submitting changes, run \`npm run lint\`, \`npm run format:check\`,\\n\`npm run typecheck\`, and \`npm run test\`. Review scope or egress changes before\\ndeploying; do not deploy or install without approval.\\n"
  }
}"
`;

