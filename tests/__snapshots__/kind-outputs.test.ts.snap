"{
  "packageJson": {
    "name": "sample",
    "version": "0.1.0",
    "type": "module",
    "license": "Apache-2.0",
    "scripts": {
      "changelog": "git cliff --config cliff.toml --unreleased",
      "forge:register": "secretspec run -- forge register",
      "forge:deploy": "secretspec run -- sh -c 'forge deploy --environment \\"$FORGE_ENVIRONMENT\\"'",
      "forge:install": "secretspec run -- sh -c 'forge install --site \\"$FORGE_SITE\\" --product \\"$FORGE_PRODUCT\\" --environment \\"$FORGE_ENVIRONMENT\\"'",
      "forge:uninstall": "secretspec run -- sh -c 'forge uninstall --site \\"$FORGE_SITE\\" --product \\"$FORGE_PRODUCT\\" --environment \\"$FORGE_ENVIRONMENT\\"'",
      "forge:upgrade": "secretspec run -- sh -c 'forge install --upgrade --site \\"$FORGE_SITE\\" --product \\"$FORGE_PRODUCT\\" --environment \\"$FORGE_ENVIRONMENT\\"'",
      "forge:variables:set": "secretspec run -- sh -c 'forge variables set --environment \\"$FORGE_ENVIRONMENT\\" \\"$@\\"' --",
      "forge:variables:set-encrypted": "secretspec run -- sh -c 'forge variables set --environment \\"$FORGE_ENVIRONMENT\\" --encrypt \\"$@\\"' --",
      "forge:variables:set:secretspec": "secretspec run -- bash scripts/forge-vars-from-secretspec.sh",
      "lint:prelint": "ast-grep scan --config node_modules/tool-forge-prelint-ast-grep/sgconfig.ecosol.yml --globs '!node_modules/**'",
      "lint:forge": "forge lint",
      "lint": "lefthook run esa-lint",
      "format": "biome format --write",
      "format:check": "biome format",
      "lint:check": "biome lint",
      "lint:fix": "biome lint --write",
      "build": "tsc --project tsconfig.json",
      "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
      "test": "bun test --pass-with-no-tests",
      "test:watch": "bun test --watch --pass-with-no-tests",
      "test:coverage": "bun test --coverage --pass-with-no-tests",
      "size": "npm run build && size-limit",
      "clean": "rm -rf dist",
      "lint:docs": "markdownlint-cli2 \\"**/*.md\\" && cspell lint \\"**/*.md\\"",
      "prepare": "lefthook install",
      "check": "lefthook run pre-push --force"
    },
    "devDependencies": {
      "@types/node": "24",
      "git-cliff": "^2.13",
      "@ast-grep/cli": "^0.44",
      "tool-forge-prelint-ast-grep": "github:ibuchanan/tool-forge-prelint-ast-grep",
      "@biomejs/biome": "^1.9.4",
      "typescript": "^5.9.3",
      "size-limit": "^11.2.0",
      "@size-limit/file": "^5.0.0",
      "cspell": "^10.3",
      "markdownlint-cli2": "^0.23",
      "lefthook": "^1.11.0"
    },
    "description": "A sample project",
    "engines": {
      "node": "24.x"
    },
    "dependencies": {
      "@forge-ahead/atlassian-api-types": "github:ibuchanan/forge-ahead-atlassian-api-types",
      "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
      "@forge-ahead/logging": "github:ibuchanan/forge-ahead-logging"
    },
    "size-limit": [
      {
        "name": "Forge app bundle",
        "path": "dist/**/*.js",
        "limit": "10 kB"
      }
    ]
  },
  "files": {
    ".editorconfig": "root = true\\n\\n[*]\\ncharset = utf-8\\nend_of_line = lf\\ninsert_final_newline = true\\ntrim_trailing_whitespace = true\\nindent_style = space\\nindent_size = 2\\n\\n[*.md]\\ntrim_trailing_whitespace = false\\n",
    ".nvmrc": "24\\n",
    ".npmrc": "# Use the public npm registry (not the default for internal Atlassians)\\nregistry=https://registry.npmjs.org/\\n",
    "secretspec.toml": "[project]\\nname = \\"sample\\"\\nrevision = \\"1.0\\"\\n\\n[profiles.default]\\nFORGE_SITE = { description = \\"Forge target site\\", default = \\"example.atlassian.net\\" }\\nFORGE_PRODUCT = { description = \\"Forge target product\\", default = \\"jira\\" }\\nFORGE_ENVIRONMENT = { description = \\"Forge target environment\\", default = \\"development\\" }\\n",
    "scripts/forge-vars-from-secretspec.sh": "#!/usr/bin/env bash\\nset -euo pipefail\\n\\n# Only configured uppercase keys in the default profile become Forge variables.\\nconfig=\\"$(cd \\"$(dirname \\"\${BASH_SOURCE[0]}\\")/..\\" && pwd)/secretspec.toml\\"\\nwhile IFS= read -r name; do\\n  [[ \\"$name\\" == FORGE* ]] && continue\\n  if ! value=\\"$(printenv \\"$name\\")\\"; then\\n    printf 'Missing configured variable: %s\\\\n' \\"$name\\" >&2\\n    exit 1\\n  fi\\n  set --\\n  [[ \\"$name\\" == *SECRET* ]] && set -- --encrypt\\n  if ! forge variables set --environment \\"$FORGE_ENVIRONMENT\\" \\"$@\\" \\"$name\\" \\"$value\\" >/dev/null 2>&1; then\\n    printf 'Failed to push variable: %s\\\\n' \\"$name\\" >&2\\n    exit 1\\n  fi\\ndone < <(awk '\\n  /^\\\\[profiles\\\\.default\\\\][[:space:]]*$/ { section=1; next }\\n  /^\\\\[/ { section=0 }\\n  section && /^[A-Z][A-Z0-9_]*[[:space:]]*=/ {\\n    key=$0; sub(/[[:space:]]*=.*/, \\"\\", key); print key\\n  }\\n' \\"$config\\")\\n",
    "biome.json": "{\\n  \\"$schema\\": \\"https://biomejs.dev/schemas/1.9.4/schema.json\\",\\n  \\"organizeImports\\": {\\n    \\"enabled\\": true\\n  },\\n  \\"linter\\": {\\n    \\"enabled\\": true,\\n    \\"rules\\": {\\n      \\"recommended\\": true\\n    }\\n  },\\n  \\"formatter\\": {\\n    \\"enabled\\": true,\\n    \\"indentStyle\\": \\"space\\",\\n    \\"indentWidth\\": 2,\\n    \\"lineEnding\\": \\"lf\\"\\n  },\\n  \\"files\\": {\\n    \\"ignore\\": [\\n      \\"node_modules\\",\\n      \\"dist\\"\\n    ]\\n  }\\n}\\n",
    "lefthook.yml": "colors: false\\noutput:\\n  - meta\\n  - summary\\n  - failure\\n\\nesa-lint:\\n  commands:\\n    esa-lint:\\n      run: npm run lint:prelint && npm run lint:check && npm run lint:forge && npm run typecheck\\n\\npre-commit:\\n  parallel: true\\n  commands:\\n    esa-gitleaks:\\n      run: |\\n        command -v gitleaks >/dev/null 2>&1 || {\\n          echo \\"gitleaks not found on PATH. Install it with: brew install gitleaks\\" >&2\\n          exit 1\\n        }\\n        gitleaks git --pre-commit --staged\\n    esa-format:\\n      run: npm run format\\n      stage_fixed: true\\n\\npre-push:\\n  commands:\\n    esa-format-check:\\n      run: npm run format:check\\n    esa-lint:\\n      run: npm run lint\\n    esa-test:\\n      run: npm run test\\n",
    "AGENTS.md": "# Agent guidance\\n\\nThis repository is an Atlassian Forge app. Read \`manifest.yml\` before\\nchanging modules, functions, scopes, or external permissions. Prefer\\nForge's built-in authentication and storage to custom services; check\\nauthorization when using app-level access.\\n\\nBefore submitting changes, run \`npm run lint\`, \`npm run format:check\`,\\n\`npm run typecheck\`, and \`npm run test\`. Review scope or egress changes before\\ndeploying; do not deploy or install without approval.\\n"
  }
}"
`;

