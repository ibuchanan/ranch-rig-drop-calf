{
  "name": "drop-calf",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "prepare": "lefthook install || true",
    "check": "lefthook run pre-push --force",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "run-p --npm-path bun --print-label \"lint:check:*\"",
    "lint:check": "biome lint",
    "lint:check:biome": "bun run lint:check",
    "lint:check:fallow": "bun run lint:fallow",
    "lint:check:format": "bun run format:check",
    "lint:check:typecheck": "bun run typecheck",
    "lint:fallow": "fallow --fail-on-issues",
    "lint:fix": "biome lint --write",
    "pins:outdated": "bunx npm-check-updates --packageFile pins/package.json",
    "refresh:gitignore": "bun run scripts/refresh-gitignore.ts",
    "refresh:oss": "bun run scripts/refresh-oss-templates.ts",
    "test": "bun test --pass-with-no-tests",
    "test:watch": "bun test --watch --pass-with-no-tests",
    "test:coverage": "bun test --coverage --pass-with-no-tests",
    "test:e2e": "bun test tests/e2e --path-ignore-patterns='vendor/**' --path-ignore-patterns='**/forge-create*'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@roadiehq/roadie-backstage-entity-validator": "2.9.1",
    "jsonc-parser": "3.3.1",
    "npm-package-json-lint": "11.0.0",
    "semver": "7.8.5",
    "smol-toml": "1.9.1",
    "sort-package-json": "^4.0.0",
    "typescript": "^5.9",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.2",
    "@types/semver": "7.8.0",
    "fallow": "3.34.1",
    "fast-check": "4.10.2",
    "lefthook": "2.2.2",
    "npm-run-all2": "9.0.3"
  }
}
